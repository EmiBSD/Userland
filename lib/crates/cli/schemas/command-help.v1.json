{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emibsd.org/schemas/cli/command-help.v1.json",
  "title": "CommandHelp",
  "description": "What `<program> --help -o json` prints: the program's options, output formats, schema, exit codes, environment and examples, for a tool or an agent that drives it.",
  "type": "object",
  "required": ["apiVersion", "kind", "name", "summary", "synopsis", "options", "outputs", "exitCodes"],
  "properties": {
    "apiVersion": { "const": "emibsd.org/v1" },
    "kind": { "const": "CommandHelp" },
    "name": { "type": "string" },
    "summary": { "type": "string" },
    "synopsis": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["short", "long", "takesValue", "value", "description"],
        "properties": {
          "short": { "type": ["string", "null"], "pattern": "^-.$" },
          "long": { "type": ["string", "null"], "pattern": "^--[a-z0-9-]+$" },
          "takesValue": { "type": "boolean" },
          "value": { "type": ["string", "null"], "description": "The placeholder of the value, when one is taken." },
          "description": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "string" }, "description": "The fixed set of values, when there is one." },
          "exclusiveGroup": { "type": "string", "description": "Options of one group exclude each other; the last given wins." }
        }
      }
    },
    "outputs": { "type": "array", "items": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } } } },
    "schema": { "type": ["string", "null"], "description": "The repository path of the schema `-o json` follows." },
    "exitCodes": { "type": "array", "items": { "type": "object", "required": ["code", "meaning"], "properties": { "code": { "type": "integer" }, "meaning": { "type": "string" } } } },
    "environment": { "type": "array", "items": { "type": "object", "required": ["name", "effect"], "properties": { "name": { "type": "string" }, "effect": { "type": "string" } } } },
    "examples": { "type": "array", "items": { "type": "object", "required": ["command", "shows"], "properties": { "command": { "type": "string" }, "shows": { "type": "string" } } } },
    "notes": { "type": "string" }
  }
}
