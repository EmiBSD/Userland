The installation notes' allarchs target makes amd64's and arm64's: the others' notes are not in the tree.

The trees keep only the Kernel's architectures (the user's decision of 2026-11-08);
tools/layout.py does not copy distrib/notes/<machine> of the others.

--- a/distrib/notes/Makefile
+++ b/distrib/notes/Makefile
@@ -18,8 +18,7 @@
 
 allarchs:
 	@cd $(.CURDIR); \
-	for arch in alpha amd64 arm64 armv7 hppa i386 landisk \
-	    luna88k macppc octeon powerpc64 riscv64 sparc64; \
+	for arch in amd64 arm64; \
 	do ${MAKE} M=$$arch; done
 
 $(TARG): $(DEP)
